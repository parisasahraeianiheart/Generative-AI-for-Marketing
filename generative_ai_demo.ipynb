import pandas as pd
import openai

# Set up OpenAI API key
openai.api_key = "your-api-key"

# Load the sample dataset
data = pd.read_csv("data/sample_products.csv")

# Function to generate marketing content
def generate_marketing_content(product_name, category):
    prompt = f"Generate a creative and engaging marketing slogan and description for a product named '{product_name}' in the '{category}' category."
    
    response = openai.Completion.create(
        engine="text-davinci-003",
        prompt=prompt,
        max_tokens=100
    )
    return response.choices[0].text.strip()

# Example: Generate content for the first product in the dataset
row = data.iloc[0]
product_name = row["Product Name"]
category = row["Category"]

content = generate_marketing_content(product_name, category)
print(f"Product: {product_name}\nCategory: {category}\nMarketing Content: {content}")

